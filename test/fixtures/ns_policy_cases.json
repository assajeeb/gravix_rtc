{
 "_comment": "Shared by the Flutter (test/fixtures) and JS (test/fixtures) SDK tests: noise-suppression engine resolver, policy parser, [GravixNS] log lines, benchmark cache key, defaults. Edit BOTH copies together (must stay byte-identical). The C core's test (native/gxns/tests/test_agc.c) also reads defaults.agcOrder. 2026-10-21 (studio benchmarks too: studio_too_slow; studio atten limit + rolling-p95 fallback + LL opt-in defaults, also pinned by native/gxns/tests/test_external.c). 2026-10-21 owner: NS is ON (mode auto) by default in every SDK entry point (enabledByDefault); apps opt out with mode off.",
 "defaults": {
  "enabledByDefault": true,
  "mode": "auto",
  "agcOrder": "ownAfterNs",
  "disableWebRtcNs": true,
  "hardwareNs": "off",
  "headsetNs": "keepOurs",
  "musicBypass": true,
  "studioDownload": "unmeteredIdle",
  "studioSource": "auto",
  "benchmarkP95Us": 3000,
  "watchdogFrameMs": 8,
  "watchdogConsecutive": 3,
  "thermalFallback": true,
  "batterySaverFallback": true,
  "studioAttenLimitDb": 40,
  "studioP95BudgetUs": 3000,
  "studioP95WindowMs": 2000,
  "studioLowLatency": false
 },
 "policies": {
  "kill_all": {
   "version": 1,
   "killSwitch": {
    "all": true
   }
  },
  "kill_studio": {
   "version": 1,
   "killSwitch": {
    "studio": true
   }
  },
  "fleet": {
   "version": 1,
   "killSwitch": {
    "all": false,
    "studio": false
   },
   "studio": {
    "allow": [
     {
      "platform": "android",
      "soc": "SM7*"
     }
    ],
    "deny": [
     {
      "platform": "android",
      "manufacturer": "infinix"
     },
     {
      "platform": "web",
      "uaRegex": "Firefox/\\d+"
     }
    ]
   },
   "standard": {
    "deny": [
     {
      "platform": "android",
      "model": "BADPHONE*"
     },
     {
      "platform": "ios",
      "osMax": "14.9"
     }
    ]
   },
   "thresholds": {
    "benchmarkP95Us": 2500
   }
  }
 },
