<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.gravitycompile.gravix_cloud">

  <!-- Audio routing (mode, communication device, speakerphone). Normal
       permission, granted at install. BLUETOOTH_CONNECT (runtime, API 31+) is
       left to the app: without it Bluetooth headsets are not detected. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <!-- Screen share: MediaProjection must run inside a foreground service,
       typed mediaProjection on API 34+. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <!-- Call foreground service (GravixCallService): keeps the microphone, the
       room playback and the room music alive in the background. DISABLED by
       default: it starts only when the app enables GravixForegroundService
       from Dart. Apps that do not want these entries remove them with
       tools:node="remove" (see the README, "Android background"). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="com.gravitycompile.gravix_cloud.rtc.ScreenCaptureService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
    <service
      android:name="com.gravitycompile.gravix_cloud.rtc.GravixCallService"
      android:enabled="true"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="microphone|mediaPlayback|camera" />
    <receiver
      android:name="com.gravitycompile.gravix_cloud.rtc.GravixCallLeaveReceiver"
      android:exported="false" />
  </application>
</manifest>
